{
  "expo": {
    "name": "Clari",
    "slug": "daily-checkin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.north2.dailycheckin",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Clari listens to your answers so your family knows you're doing well.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.north2.dailycheckin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Clari"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Clari listens to your answers so your family knows you're doing well."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "scheme": "dailycheckin",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8FB"
    },
    "primaryColor": "#1A457D"
  }
}
