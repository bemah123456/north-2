{
  "expo": {
    "name": "Daily Check-in",
    "slug": "daily-checkin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.north2.dailycheckin",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Daily Check-in listens to your answers so your family knows you're doing well.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.north2.dailycheckin",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Daily Check-in listens to your answers so your family knows you're doing well."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "dailycheckin"
  }
}
