+@pytest.mark.skipif(not shutil.which("ffmpeg"), reason="needs ffmpeg")
+def test_decodes_m4a_with_index_at_end(tmp_path):
+    # Android and iOS recorders write the m4a index after the audio, which
+    # ffmpeg can't read from a pipe.
+    wav, m4a = tmp_path / "a.wav", tmp_path / "a.m4a"
+    subprocess.run(["ffmpeg", "-loglevel", "error", "-f", "lavfi", "-i", "sine=frequency=440:duration=1",
+                    "-ar", "16000", str(wav)], check=True)
+    subprocess.run(["ffmpeg", "-loglevel", "error", "-i", str(wav), "-c:a", "aac", str(m4a)], check=True)
+    samples = transcribe._decode_16k(m4a.read_bytes())
+    assert abs(len(samples) - 16000) < 2000
