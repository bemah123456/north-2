+def _decode_16k(audio: bytes):
+    """Decode with ffmpeg through a temporary file. The pipeline's own
+    decoder reads from a pipe, which fails on an m4a whose index sits at
+    the end of the file (how Android, and often iOS, write recordings)."""
+    import subprocess
+    import tempfile
+
+    import numpy as np
+
+    with tempfile.NamedTemporaryFile(suffix=".audio") as f:
+        f.write(audio)
+        f.flush()
+        p = subprocess.run(
+            ["ffmpeg", "-loglevel", "error", "-i", f.name, "-f", "f32le", "-ac", "1", "-ar", "16000", "pipe:1"],
+            capture_output=True,
+        )
+    if p.returncode != 0:
+        raise TranscriptionUnavailable("Could not decode the recording: " + p.stderr.decode(errors="replace")[-200:])
+    return np.frombuffer(p.stdout, dtype=np.float32)
+
